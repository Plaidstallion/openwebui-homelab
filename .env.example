# Copy this file to .env and fill in your own real values.
# On the actual server this repo was built from, these live in /etc/environment
# instead of a .env file (see docs/backup-and-restore.md) - either approach works,
# Docker Compose will read a .env file in this same directory automatically.

# --- Core ---
PUID=1000
PGID=1000
TZ=America/Chicago
USERDIR=/home/youruser
LINUX_USER=youruser
POOL=/mnt/pool
DOMAINNAME=yourdomain.com

# --- LAN IPs (adjust to your own network) ---
SERVER_LAN_IP=192.168.1.100
GAMING_PC_IP=192.168.1.150

# --- Cloudflare (DNS challenge + Traefik) ---
CLOUDFLARE_EMAIL=your-email@example.com
CLOUDFLARE_API_KEY=your-cloudflare-global-api-key
CLOUDFLARE_ZONE_TOKEN=your-cloudflare-zone-token

# --- Google OAuth (traefik-forward-auth) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
OAUTH_SECRET=generate-a-random-string-here
# Comma-separated list of Google account emails allowed through the OAuth wall
GGMAIL=first-allowed-email@example.com
JMAIL=second-allowed-email@example.com
DMAIL=third-allowed-email@example.com
EJGMAIL=optional-fourth-email@example.com

# --- SearXNG ---
SEARXNG_SECRET_KEY=generate-a-random-string-here

# --- Outbound email (SES-style SMTP creds, used by Watchtower notifications) ---
SENDMAIL_ADDR=your-smtp-username
SENDMAIL_PW=your-smtp-password

# --- Duplicati (backup) ---
DUPLICATI_WEBUI_PASS=generate-a-random-password-here
DUPLICATI_ENCRYPTION_KEY=generate-a-random-key-here
# IMPORTANT: back this key up somewhere OFF this server (password manager, etc).
# If you lose it and the OS drive dies, your Duplicati backups are unrecoverable.

# --- Only needed if you uncomment the matching optional services ---
# NCMYSQL_PASS=
# NCMYSQL_ROOT_PASS=
# SPLUNKTOKEN=
# MAPTOKEN=
# MVAD_ACCT=
# BWRS_ADMIN=
